
<main class="w-full max-w-2xl bg-surface-container-lowest rounded-xl shadow-ambient border border-outline-variant p-6 md:p-10 flex flex-col gap-8 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
    <div class="flex flex-col gap-2 z-10">
        <h1 class="font-h1 text-h1 text-primary tracking-tight">Share your experience</h1>
        <p class="font-body-lg text-body-lg text-secondary">Your feedback helps us to improve our services</p>
      <!-- 1. Display Global Error Messages if validation fails -->
      <% if @errors && @errors.any? %>
        <div style="color: red; margin-bottom: 20px;">
          <strong>Please correct the following errors:</strong>
          <ul>
            <% @errors.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
        <form class="flex flex-col gap-8 z-10" action="/" method="post">
          <!-- Radio Buttons Group -->
          <!-- TODO
          change styles, starts in a row or buttons
          -->
          <!-- Qualifications (Radio Buttons 1 to 5) -->
          <fieldset class="flex flex-col gap-3">
            <legend class="font-label-md text-label-md text-on-surface-variant mb-1">How would you rate your experience?</legend>
            <div class="flex flex-wrap gap-3 sm:gap-4 justify-between sm:justify-start" id="rating-group">
              <% (1..5).each do |num| %>
                <label style="margin-right: 15px;">
                  <input type="radio"
                         name="feedback[qualifications]"
                         value="<%= num %>"
                         <%= 'checked' if @feedback && @feedback['qualifications'].to_i == num %>>
                  <%= num %>
                </label>
              <% end %>
            </div>
          </fieldset>
          <!-- Text Field -->
          <div class="flex flex-col gap-2">
            <label for="description" class="font-label-md text-label-md text-on-surface-variant">Tell us more about it</label>
            <textarea
              id="description"
              name="feedback[description]"
              class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest p-4 font-body-md text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-y min-h-[120px]"
              placeholder="Share specific details, suggestions, or issues you encountered..."
              rows="5"
            ><%= @feedback['description'] if @feedback %></textarea>
          </div>
          <hr class="border-t border-outline-variant opacity-50 my-2" />
          <div class="flex justify-end mt-2">
            <button type="submit" class="w-full sm:w-auto px-6 py-3 h-12 rounded-lg bg-primary text-on-primary font-label-md text-label-md flex items-center justify-center gap-2 transition-all hover:bg-primary-container hover:text-on-primary-container active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 shadow-sm group">
              Submit Feedback
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform" data-icon="send">send</span>
            </button>
          </div>
        </form>
    </div>
  </div>
</main>