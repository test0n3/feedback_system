<main class="shadow-ambient">
  <header>
    <div id="logo" class="hidden">
      <img width="150" height="150" alt="company logo">
    </div>
    <h1 class="hidden">Customer Feedback</h1>
    <h2>Share your experience</h2>
    <p>Your feedback helps us to improve our services</p>
    <% if flash[:notice] %>
      <div class="text-green-700"><%= h(flash[:notice]) %></div>
    <% end %>
    <% if @errors %>
      <div class="text-red-700"><%= h(flash[:error]) %></div>
    <% end %>
    <!-- 1. Display Global Error Messages if validation fails -->
    <% if @errors && @errors.any? %>
      <div class="error-container">
        <p>Please correct the following errors:</p>
        <ul>
          <% @errors.each do |error| %>
            <li><%= h(error) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </header>
  <form action="/" method="post" class="no-js" id="feedback-form">
    <%= csrf_tag %>
    <fieldset id="qualification-fieldset">
      <legend>How would you rate your experience?</legend>
      <div id="rating-group">
        <% (1..5).each do |num| %>
          <div class="radio-btn">
            <input
              id="rating-<%= num %>"
              type="radio"
              name="feedback[qualification]"
              value="<%= num %>"
              <%= 'checked' if @feedback && @feedback['qualification'].to_s == num.to_s %>
            >
            <label for="rating-<%= num %>" class="radio-group"><%= num %></label>
          </div>
          <button
            aria-label="Rate <%= num %> out of 5"
            aria-pressed="<%= (@feedback && @feedback['qualification'].to_s == num.to_s) ? 'true' : 'false' %>"
            class="rating-btn <%= 'active' if @feedback && @feedback['qualification'].to_s == num.to_s %>"
            data-value="<%= num %>"
            type="button"
          >
            <%= num %>
          </button>
        <% end %>
      </div>
    </fieldset>
    <div id="description-container">
      <label for="description">Tell us more about it</label>
      <textarea
        id="description"
        name="feedback[description]"
        placeholder="Share specific details, suggestions, or issues you encountered..."
        rows="5"
      ><%= h(@feedback["description"]) if @feedback && @feedback["description"] %></textarea>
    </div>
    <hr id="bottom-divider"/>
    <div class="button-container">
      <button type="submit" class="group">
        Submit Feedback
        <span
          class="group-hover:translate-x-1 material-symbols-outlined"
          data-icon="send"
        >send</span>
      </button>
    </div>
  </form>
</main>
<script>document.getElementById('feedback-form').classList.replace('no-js', 'js')</script>
<script type="module" src="js/output.js"></script>
